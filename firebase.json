{
  "hosting": {
    "site": "drivepad-client",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/i/*/manifest.webmanifest",
        "destination": "/manifest-tenant.webmanifest"
      },
      {
        "source": "/api/delete-account",
        "function": "deleteAccount",
        "region": "europe-west1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}